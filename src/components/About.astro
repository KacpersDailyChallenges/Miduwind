---
interface AboutProps {
    name: string;
    summary: string;
    textColor: string;
}

import { about } from "@/data.json";

const { name, summary, textColor } = about satisfies AboutProps;
---

<section class="py-4 text-center about-custom">
    <h1 class="text-2xl font-bold">{name}</h1>
    <!-- Stała proporcja (bez breakpointów) -> zawsze ok. 40% węższe niż siatka kafelków (100% body), bez skoków przy zmianie szerokości ekranu -->
    <p class="pt-2.5 text-balance mx-auto w-9/10">{summary}</p>
</section>

<style define:vars={{ textColor }}>
    .about-custom {
        color: var(--textColor)
    }
</style>