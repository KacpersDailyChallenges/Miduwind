---
interface HeaderProps {
    image: string;
    alt: string;
    username: string;
    accentColor: string;
    setMonospace: boolean;
    setVerified: boolean;
}

import { header } from "@/data.json";
import VerifiedIcon from "@/assets/VerifiedIcon.svg";

const { image, alt, username, accentColor, setMonospace, setVerified } =
    header satisfies HeaderProps;
---

<section class="flex flex-col items-center justify-center pt-12 pb-8">
    <div class="relative">
        <div class="absolute -inset-4 rounded-full bg-orange-500"></div>
        <img
            src={image}
            alt={alt}
            class="relative w-70 rounded-full mask-b-from-90%"
        />
        <!-- Cały badge (tekst + ikona) przyklejony do dołu zdjęcia -->
        <span
            class="absolute -bottom-3 left-1/2 -translate-x-1/2 z-10 flex gap-1 px-3 py-0.5 header-custom bg-black/60 text-lg font-bold whitespace-nowrap border-1 rounded-xl"
        >
            {username}
            {setVerified && <VerifiedIcon />}
        </span>
    </div>
</section>

<style define:vars={{ accentColor }}>
    .header-custom {
        color: var(--accentColor);
        border-color: var(--accentColor);
    }
</style>
