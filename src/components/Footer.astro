---
interface FooterItem {
    credits: string;
    url: string;
}

interface FooterProps {
    textColor: string;
    items: FooterItem[];
}

import { footer } from "@/data.json";

const { textColor, items } = footer satisfies FooterProps;
---

{
    items?.length ? (
        <footer class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 pt-10 pb-2 text-xs text-center footer-custom">
            {items.map((item, i) => (
                <>
                    {i > 0 && <span class="opacity-50">•</span>}
                    {item.url ? (
                        <a href={item.url} target="_blank" class="hover:underline">
                            {item.credits}
                        </a>
                    ) : (
                        <span>{item.credits}</span>
                    )}
                </>
            ))}
        </footer>
    ) : (
        <br />
    )
}

<style define:vars={{ textColor }}>
    .footer-custom {
        color: var(--textColor);
    }
</style>
