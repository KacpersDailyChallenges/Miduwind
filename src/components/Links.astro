---
interface LinkProps {
    network: string;
    message: string;
    url: string;
    logo: string;
    topColor: string;
    middleColor: string;
    bottomColor: string;
}

import SocialCard from "@/components/grid/SocialCard.astro";
import GridTwoOne from "@/components/grid/GridTwoOne.astro";
import GridOneTwo from "@/components/grid/GridOneTwo.astro";
import { links, globalSettings } from "@/data.json";

// Grupujemy linki po 2 – jedna para = jeden rząd kafelków
const pairs: LinkProps[][] = [];
for (let i = 0; i < links.length; i += 2) {
    pairs.push(links.slice(i, i + 2));
}
---

<section class="flex flex-col w-full gap-2 mx-auto">
    {
        pairs.map((pair, i) => {
            // Parzyste rzędy (0, 2, 4...) -> 2fr/1fr, nieparzyste -> 1fr/2fr
            const Grid = i % 2 === 0 ? GridTwoOne : GridOneTwo;
            return (
                <Grid>
                    {pair.map((link) => (
                        <SocialCard {...link} globalSettings={globalSettings} />
                    ))}
                </Grid>
            );
        })
    }
</section>
