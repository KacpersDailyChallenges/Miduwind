
Socialcard · ASTRO
---
const { network, message, url, logo, topColor, middleColor, bottomColor, globalSettings } =
    Astro.props;
 
// Wstępne (bazowe) skalowanie ikony - obowiązuje zawsze, niezależnie od hover.
const zoom = globalSettings?.logoZoom ?? 1.2;
 
// Odległość ikony od prawej/dolnej krawędzi kafelka. Wartości to gotowe długości CSS
// (np. "rem", "px", "%"), więc jednostkę dobiera się w data.json - polecane: rem.
const distanceFromRight = globalSettings?.logoDistanceFromRight ?? "-0.75rem";
const distanceFromBottom = globalSettings?.logoDistanceFromBottom ?? "-0.75rem";
---
 
<a
    href={url}
    target="_blank"
    class={`relative flex flex-col justify-between h-40 overflow-hidden text-white transition rounded-xl hover:scale-102 hover:contrast-110 group
    ${middleColor ? "three-color-gradient" : "two-color-gradient"}`}
>
    <div class="pt-2 pl-3">
        <span class="px-2 py-1 text-sm border rounded-xl">{message}</span>
    </div>
 
    <p class="pb-2 pl-3 text-xl font-bold">{network}</p>
 
    <img
        src={logo}
        alt={`${network} logo`}
        class="absolute size-25"
        style={`right: ${distanceFromRight}; bottom: ${distanceFromBottom}; transform: scale(${zoom}); transform-origin: bottom right;`}
    />
</a>
 
<style define:vars={{ topColor, middleColor, bottomColor }}>
    .two-color-gradient {
        background: linear-gradient(var(--topColor), var(--bottomColor));
    }
 
    .three-color-gradient {
        background: linear-gradient(
            var(--topColor),
            var(--middleColor),
            var(--bottomColor)
        );
    }
</style>
