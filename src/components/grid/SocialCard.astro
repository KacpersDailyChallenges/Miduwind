---
const { network, message, url, logo, topColor, middleColor, bottomColor, globalSettings } =
    Astro.props;

const zoom = globalSettings?.logoZoom || 1.2;
---

<a
    href={url}
    target="_blank"
    class={`flex flex-col justify-between h-40 overflow-hidden text-white transition rounded-xl hover:scale-102 hover:contrast-110 group
    ${middleColor ? "three-color-gradient" : "two-color-gradient"}`}
>
    <div class="pt-2 pl-3">
        <span class="px-2 py-1 text-sm border rounded-xl">{message}</span>
    </div>

    <div class="flex items-end justify-between">
        <p class="pb-2 pl-3 text-xl font-bold">{network}</p>

        <img
            src={logo}
            alt={`${network} logo`}
            class="-mb-3 -mr-3 transition-transform size-25"
            style="transform: scale(1);"
            on:mouseenter={(e) => {
                e.target.style.transform = `scale(${zoom})`;
            }}
            on:mouseleave={(e) => {
                e.target.style.transform = 'scale(1)';
            }}
        />
    </div>
</a>

<style define:vars={{ topColor, middleColor, bottomColor }}>
    .two-color-gradient {
        background: linear-gradient(var(--topColor), var(--bottomColor));
    }

    .three-color-gradient {
        background: linear-gradient(
            var(--topColor),
            var(--middleColor),
            var(--bottomColor)
        );
    }
</style>
